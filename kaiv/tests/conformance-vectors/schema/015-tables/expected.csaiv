.!csaiv acme/fleet
/@servers [unique::host,port] [min=1] [max=3]
!str'/@servers/::host=
!int /^-?[0-9]+$/ ..num [1,65535]'/@servers/::port=
/@departments [unique::name]
!str'/@departments/::name=
/@employees [ref::department=/@departments/*::name]
!str'/@employees/::name=
!str'/@employees/::department=
